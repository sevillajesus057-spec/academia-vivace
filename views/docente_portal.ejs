<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal del Colaborador - Academia Vivace</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { padding: 2rem; background: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .container-docente { max-width: 900px; margin: 0 auto; }
        .card-profile { background: white; padding: 2rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 1.5rem; }
        .badge-bcv { background: #e8f4fd; color: #1e3c72; padding: 6px 14px; border-radius: 20px; font-weight: bold; font-size: 0.85rem; }
        .grid-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
        .box-stat { padding: 1.2rem; border-radius: 8px; }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .table-custom th { background: #1e3c72; color: white; text-align: left; padding: 10px; font-size: 0.85rem; }
        .table-custom td { padding: 10px; border-bottom: 1px solid #eee; font-size: 0.85rem; }
        .monto-abono { font-weight: bold; color: #27ae60; }
        .monto-adelanto { font-weight: bold; color: #e67e22; }
    </style>
</head>
<body>

    <div class="container-docente">
        <div class="card-profile">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 style="color: #1e3c72; margin: 0;"><%= docente.nombre_empleado %></h1>
                    <p style="color: #666; margin: 0.3rem 0 0 0;"><%= docente.cargo %> | CI: <%= docente.cedula || 'Sin Cédula' %></p>
                </div>
                <div>
                    <span class="badge-bcv">Tasa BCV Oficial: <%= Number(tasaBCV).toFixed(2) %> Bs/$</span>
                </div>
            </div>

            <div class="grid-stats">
                <div class="box-stat" style="background: #ebf5fb; border-left: 4px solid #2980b9;">
                    <span style="font-size: 0.85rem; color: #555;">Asignación Total Bruta:</span>
                    <h3 style="color: #2980b9; margin: 4px 0 0 0;"><%= Number(totalBrutoVES).toFixed(2) %> Bs.</h3>
                </div>
                <div class="box-stat" style="background: #e8f8f5; border-left: 4px solid #27ae60;">
                    <span style="font-size: 0.85rem; color: #555;">Monto Cobrado / Abonado:</span>
                    <h3 style="color: #27ae60; margin: 4px 0 0 0;"><%= Number(totalPagadoVES).toFixed(2) %> Bs.</h3>
                </div>
                <div class="box-stat" style="background: #fef5e7; border-left: 4px solid #e67e22;">
                    <span style="font-size: 0.85rem; color: #555;">Adelantos Recibidos:</span>
                    <h3 style="color: #e67e22; margin: 4px 0 0 0;"><%= Number(totalAdelantosVES).toFixed(2) %> Bs.</h3>
                </div>
                <div class="box-stat" style="background: #fdedec; border-left: 4px solid #c0392b;">
                    <span style="font-size: 0.85rem; color: #555;">Saldo Neto por Cobrar:</span>
                    <h3 style="color: #c0392b; margin: 4px 0 0 0;"><%= Number(saldoPendienteVES).toFixed(2) %> Bs.</h3>
                </div>
            </div>
        </div>

        <div class="card-profile">
            <h2 style="color: #1e3c72; margin-bottom: 0.5rem;">Comprobante Digital de Pagos y Transferencias</h2>
            <p style="color: #666; font-size: 0.9rem;">Detalle de depósitos, pagos móviles y anticipos procesados por la Academia Vivace.</p>

            <div style="overflow-x: auto;">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th>N° Referencia</th>
                            <th>Monto Cancelado (Bs.)</th>
                            <th>Equivalente ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pagos && pagos.length > 0) { %>
                            <% pagos.forEach(p => { 
                                const esAdelanto = p.tipo_pago === 'ADELANTO';
                                const claseColor = esAdelanto ? 'monto-adelanto' : 'monto-abono';
                            %>
                                <tr>
                                    <td><%= String(p.fecha_pago).substring(0,10) %></td>
                                    <td>
                                        <strong><%= p.tipo_pago %></strong>
                                        <% if (p.observacion) { %><br><small style="color: #666;"><%= p.observacion %></small><% } %>
                                    </td>
                                    <td><span style="background: #f0f0f0; padding: 3px 6px; border-radius: 4px; font-weight: bold;"><%= p.referencia %></span></td>
                                    <td class="<%= claseColor %>">
                                        <%= Number(p.monto_ves).toFixed(2) %> Bs.
                                    </td>
                                    <td>$<%= Number(p.monto_usd).toFixed(2) %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; color: #888; padding: 2rem;">Aún no se registran movimientos o pagos para este período.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>