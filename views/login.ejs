<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academia Vivace - Iniciar Sesión</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-body">

    <div class="login-container">
        <div class="logo-box">
            <!-- Imagen del logo en public/img/logo_vivace.png -->
            <img src="/img/logo_vivace.png" alt="Logo Academia Vivace" class="academy-logo">
            <h1>Academia Vivace</h1>
            <p>Portal de Representantes y Estudiantes</p>
        </div>

        <form action="/login" method="POST" class="login-form">
            <h2>Bienvenido</h2>
            <p class="instruction">Ingresa el correo electrónico registrado por la administración para acceder.</p>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="error-alert">
                    <%= error %>
                </div>
            <% } %>

            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="ejemplo@correo.com" 
                    required
                >
            </div>

            <button type="submit" class="btn-primary">Ingresar al Portal</button>
        </form>
    </div>

</body>
</html>