<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Administrativo - Academia Vivace</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { padding: 2rem; background: var(--vivace-light, #f4f6f9); font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: var(--vivace-dark, #333); }
        .container-admin { max-width: 1150px; margin: 0 auto; }
        .header-panel { background: var(--vivace-card-bg, white); padding: 2.5rem 2rem; border-radius: 16px; text-align: center; box-shadow: 0 4px 20px rgba(123,44,191,0.08); margin-bottom: 1.5rem; position: relative; border-top: 5px solid var(--vivace-magenta, #e0248c); }
        .academy-logo-admin { max-width: 240px; height: auto; margin-bottom: 0.8rem; }
        .badge-bcv { display: inline-block; background: #e0fbfc; color: var(--vivace-blue, #0077b6); padding: 8px 18px; border-radius: 20px; font-weight: bold; margin-top: 0.8rem; font-size: 0.95rem; border: 1px solid var(--vivace-cyan, #00b4d8); }
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 1.2rem; margin-top: 2rem; }
        .menu-card { background: white; border: 2px solid #e9ecef; border-radius: 12px; padding: 1.5rem 1rem; text-align: center; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 4px 10px rgba(0,0,0,0.03); }
        .menu-card:hover { border-color: var(--vivace-purple, #7b2cbf); transform: translateY(-4px); box-shadow: 0 8px 20px rgba(123,44,191,0.15); }
        .menu-card-icon { font-size: 2.4rem; margin-bottom: 0.4rem; }
        .menu-card-title { color: var(--vivace-purple, #7b2cbf); margin: 0.3rem 0 0.2rem 0; font-size: 1.1rem; }
        .menu-card-desc { color: #666; font-size: 0.85rem; margin: 0; }
        .seccion-admin { display: none; background: white; padding: 2rem; border-radius: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-top: 1.5rem; }
        .btn-volver { background: #6c757d; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-bottom: 1.5rem; display: inline-flex; align-items: center; gap: 0.5rem; }
        .btn-volver:hover { background: #5a6268; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; }
        .form-group { display: flex; flex-direction: column; gap: 0.3rem; }
        .form-group label { font-weight: bold; font-size: 0.88rem; color: #444; }
        .form-group input, .form-group select, .form-group textarea { padding: 9px 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 0.95rem; width: 100%; }
        .btn-submit-green { background: var(--vivace-green, #2a9d8f); color: white; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 1rem; margin-top: 1rem; width: 100%; }
        .btn-submit-green:hover { opacity: 0.9; }
        .btn-submit-orange { background: var(--vivace-orange, #f77f00); color: white; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 1rem; margin-top: 1rem; }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .table-custom th { background: linear-gradient(135deg, var(--vivace-purple, #7b2cbf), var(--vivace-blue, #0077b6)); color: white; text-align: left; padding: 11px; font-size: 0.85rem; }
        .table-custom td { padding: 11px; border-bottom: 1px solid #eee; font-size: 0.85rem; }
        .badge-aldia { background: #d4edda; color: #155724; padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; }
        .badge-moroso { background: #f8d7da; color: #721c24; padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; }
        .badge-exonerado { background: #fce7f3; color: #db2777; padding: 4px 10px; border-radius: 20px; font-weight: bold; font-size: 0.8rem; border: 1px solid #fbcfe8; }
        .modal-bg { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 1000; justify-content: center; align-items: center; }
        .modal-card { background: white; width: 90%; max-width: 680px; padding: 2rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); position: relative; max-height: 88vh; overflow-y: auto; }
        .close-modal { position: absolute; top: 1rem; right: 1.2rem; font-size: 1.5rem; font-weight: bold; cursor: pointer; color: #888; }
        fieldset { border: 1px solid #ddd; padding: 1.2rem; border-radius: 8px; margin-bottom: 1rem; }
        legend { font-weight: bold; color: var(--vivace-purple, #7b2cbf); padding: 0 8px; }
        .txt-pendiente-deuda { font-weight: bold; color: #c0392b; font-size: 1.05rem; }
        .txt-pendiente-ok { font-weight: bold; color: #27ae60; font-size: 1.05rem; }
        .info-monto-sugerido { background: #e8f4fd; border: 1px solid #b2d7f5; padding: 8px 12px; border-radius: 6px; font-size: 0.85rem; color: #1e3c72; font-weight: bold; margin-top: 0.4rem; }
        .btn-logout { position: absolute; top: 1rem; right: 1rem; background: #c0392b; color: white; padding: 6px 12px; text-decoration: none; border-radius: 6px; font-size: 0.85rem; font-weight: bold; }
        
        .btn-estado-pagado { background: #d4edda; color: #155724; border: 1px solid #c3e6cb; padding: 6px 10px; border-radius: 6px; font-weight: bold; font-size: 0.78rem; cursor: pointer; display: inline-block; width: 100%; text-align: center; }
        .btn-estado-pendiente { background: #fff3cd; color: #856404; border: 1px solid #ffe8a1; padding: 6px 10px; border-radius: 6px; font-weight: bold; font-size: 0.78rem; cursor: pointer; display: inline-block; width: 100%; text-align: center; }

        .box-liquidez-ok { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; padding: 1.2rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
        .box-liquidez-alerta { background: #fff3cd; border: 1px solid #ffe8a1; color: #856404; padding: 1.2rem; border-radius: 8px; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
    </style>
</head>
<body>

    <div class="container-admin">
        
        <!-- DASHBOARD INICIAL -->
        <div id="pantalla-inicio-admin" class="header-panel">
            <a href="/admin/logout" class="btn-logout">🔒 Cerrar Sesión</a>
            <img src="/img/logo_vivace.png" alt="Logo Academia Vivace" class="academy-logo-admin">
            <h1 style="color: var(--vivace-purple, #7b2cbf); margin: 0; font-size: 2.2rem;">Academia de Música Vivace</h1>
            <p style="color: #666; font-size: 1.05rem; margin-top: 0.3rem;">Sistema de Gestión Administrativa, Control Escolar y Contabilidad SENIAT</p>
            <span class="badge-bcv">Tasa Oficial BCV (Automática): <%= Number(typeof tasaBCV !== 'undefined' ? tasaBCV : 813.74).toFixed(2) %> Bs/$</span>

            <!-- SECCIÓN NUEVA: CONTROL DE CIERRE Y AUTORIZACIÓN DE BOLETINES -->
            <div style="background: #fdf4ff; border: 2px dashed var(--vivace-purple, #7b2cbf); padding: 1.2rem; border-radius: 12px; margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div style="text-align: left;">
                    <h3 style="color: var(--vivace-purple, #7b2cbf); font-size: 1.1rem; margin-bottom: 0.2rem;">🎓 Autorización de Boletines Informativos</h3>
                    <p style="color: #555; font-size: 0.88rem; margin: 0;">Al activar esta opción, los representantes podrán descargar los boletines en PDF con calificaciones, asistencias y observaciones.</p>
                </div>
                <form action="/admin/toggle-boletin" method="POST">
                    <% const boletinActivo = typeof boletinAutorizado !== 'undefined' && boletinAutorizado; %>
                    <button type="submit" style="background: <%= boletinActivo ? '#27ae60' : '#e67e22' %>; color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 0.95rem;">
                        <%= boletinActivo ? '🟢 Boletines Autorizados (Clic para Desactivar)' : '🔒 Boletines Bloqueados (Clic para Autorizar)' %>
                    </button>
                </form>
            </div>

            <div class="menu-grid">
                <div class="menu-card" onclick="mostrarSeccion('registro')">
                    <div class="menu-card-icon">📝</div>
                    <h3 class="menu-card-title">Registrar Estudiante</h3>
                    <p class="menu-card-desc">Ficha de nueva inscripción</p>
                </div>
                <div class="menu-card" onclick="mostrarSeccion('nomina-alumnos')">
                    <div class="menu-card-icon">🎓</div>
                    <h3 class="menu-card-title">Nómina Estudiantes</h3>
                    <p class="menu-card-desc"><%= (typeof estudiantes !== 'undefined' && estudiantes ? estudiantes : []).length %> alumnos matriculados</p>
                </div>
                <div class="menu-card" onclick="mostrarSeccion('finanzas')">
                    <div class="menu-card-icon">📊</div>
                    <h3 class="menu-card-title">Finanzas y SENIAT</h3>
                    <p class="menu-card-desc">Libro de Compras e Ingresos Exentos</p>
                </div>
                <div class="menu-card" onclick="mostrarSeccion('conciliacion')">
                    <div class="menu-card-icon">🏦</div>
                    <h3 class="menu-card-title">Conciliación Bancaria</h3>
                    <p class="menu-card-desc"><%= (typeof cobrosPorRevisar !== 'undefined' && cobrosPorRevisar ? cobrosPorRevisar : []).length %> pagos pendientes</p>
                </div>
                <div class="menu-card" onclick="mostrarSeccion('personal')">
                    <div class="menu-card-icon">🎼</div>
                    <h3 class="menu-card-title">Nómina de Personal</h3>
                    <p class="menu-card-desc"><%= (typeof personal !== 'undefined' && personal ? personal : []).length %> colaboradores registrados</p>
                </div>
            </div>
        </div>

        <!-- MÓDULO 1: REGISTRO DE ESTUDIANTES (CON EXONERACIÓN) -->
        <div id="seccion-registro" class="seccion-admin">
            <button class="btn-volver" onclick="volverInicio()">⬅ Menú Principal</button>
            <h2 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 1rem;">Ficha Completa de Inscripción</h2>
            <form action="/admin/agregar-estudiante" method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
                <fieldset>
                    <legend>Datos del Estudiante</legend>
                    <div class="form-grid">
                        <div class="form-group"><label>Nombres y Apellidos *</label><input type="text" name="nombre_estudiante" required placeholder="Ej: Jesús Sevilla"></div>
                        <div class="form-group"><label>Cédula de Identidad / Escolar</label><input type="text" name="cedula_estudiante" placeholder="Ej: V-30483601"></div>
                        <div class="form-group"><label>Fecha de Nacimiento</label><input type="date" name="fecha_nacimiento"></div>
                        <div class="form-group"><label>Edad</label><input type="number" name="edad" placeholder="Ej: 12"></div>
                        <div class="form-group"><label>Tipo de Sangre</label><input type="text" name="tipo_sangre" placeholder="Ej: ORH+"></div>
                        <div class="form-group"><label>URL Foto Alumno</label><input type="text" name="foto" placeholder="/img/logo_vivace.png"></div>
                    </div>
                </fieldset>
                <fieldset>
                    <legend>Datos del Representante</legend>
                    <div class="form-grid">
                        <div class="form-group"><label>Nombre del Representante *</label><input type="text" name="nombre_representante" required></div>
                        <div class="form-group"><label>Cédula</label><input type="text" name="cedula_representante"></div>
                        <div class="form-group"><label>Teléfono (WhatsApp)</label><input type="text" name="telefono_representante"></div>
                        <div class="form-group"><label>Parentesco</label><input type="text" name="parentesco"></div>
                    </div>
                    <div class="form-group" style="margin-top: 0.8rem;"><label>Correo Electrónico (Acceso al Portal) *</label><input type="email" name="email_representante" required></div>
                </fieldset>
                <fieldset>
                    <legend>Académica</legend>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Cátedra / Instrumento *</label>
                            <select name="instrumento" required>
                                <option value="">Seleccione un instrumento...</option>
                                <option value="PERCUSION">PERCUSION</option>
                                <option value="CUATRO">CUATRO</option>
                                <option value="GUITARRA">GUITARRA</option>
                                <option value="TECLADO">TECLADO</option>
                                <option value="BAJO ELECTRICO">BAJO ELECTRICO</option>
                                <option value="OTRO">OTRO</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Nivel *</label>
                            <select name="nivel" required>
                                <option value="INFANTIL">INFANTIL</option>
                                <option value="INFANTIL I">INFANTIL I</option>
                                <option value="JUVENIL">JUVENIL</option>
                                <option value="JUVENIL I">JUVENIL I</option>
                            </select>
                        </div>
                    </div>
                </fieldset>

                <!-- Opción de Exonerar Pagos al Registrar -->
                <div style="background: #fdf2f8; padding: 12px 16px; border-radius: 8px; border: 1px solid #fbcfe8; display: flex; align-items: center; gap: 12px;">
                    <input type="checkbox" name="exonerado" value="1" id="checkRegistroExonerado" style="width: 20px; height: 20px; cursor: pointer;">
                    <label for="checkRegistroExonerado" style="cursor: pointer; font-weight: bold; color: #db2777; font-size: 0.95rem;">
                        ⭐ Exonerar de pagos automáticos (Matrícula y Mensualidades)
                    </label>
                </div>

                <button type="submit" class="btn-submit-green">Guardar e Inscribir Alumno</button>
            </form>
        </div>

        <!-- MÓDULO 2: NÓMINA DE ESTUDIANTES CON BUSCADOR EN VIVO Y EDICIÓN/ELIMINACIÓN -->
        <div id="seccion-nomina-alumnos" class="seccion-admin">
            <button class="btn-volver" onclick="volverInicio()">⬅ Menú Principal</button>
            <h2 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.5rem;">Nómina General de Estudiantes</h2>
            
            <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
                <input type="text" id="inputFiltroNombre" placeholder="Escribe para buscar por nombre..." onkeyup="filtrarTablaEstudiantes()" style="padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; flex: 2; min-width: 200px;">
                
                <select id="selectFiltroGrupo" onchange="filtrarTablaEstudiantes()" style="padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; flex: 1; min-width: 140px;">
                    <option value="">Todos los grupos</option>
                    <option value="INFANTIL">INFANTIL</option>
                    <option value="INFANTIL I">INFANTIL I</option>
                    <option value="JUVENIL">JUVENIL</option>
                    <option value="JUVENIL I">JUVENIL I</option>
                </select>

                <select id="selectFiltroInstrumento" onchange="filtrarTablaEstudiantes()" style="padding: 8px 12px; border: 1px solid #ccc; border-radius: 6px; flex: 1; min-width: 140px;">
                    <option value="">Todos los instrumentos</option>
                    <option value="PERCUSION">PERCUSION</option>
                    <option value="CUATRO">CUATRO</option>
                    <option value="GUITARRA">GUITARRA</option>
                    <option value="TECLADO">TECLADO</option>
                    <option value="BAJO ELECTRICO">BAJO ELECTRICO</option>
                    <option value="OTRO">OTRO</option>
                </select>

                <button type="button" onclick="limpiarFiltros()" style="background: #6c757d; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; cursor: pointer;">Limpiar</button>
            </div>

            <div style="overflow-x: auto;">
                <table class="table-custom" id="tablaEstudiantesAdmin">
                    <thead>
                        <tr><th>Estudiante</th><th>Cátedra</th><th>Representante y Contacto</th><th>Estatus</th><th>Acciones (Editar / WhatsApp Manual / Expediente)</th></tr>
                    </thead>
                    <tbody>
                        <% if (typeof estudiantes !== 'undefined' && estudiantes && estudiantes.length > 0) { %>
                            <% estudiantes.forEach((est) => { 
                                const deudaUsdNum = Number(est.deudaUSD || 0);
                                const deudaBsNum = deudaUsdNum * Number(typeof tasaBCV !== 'undefined' ? tasaBCV : 813.74);
                                const fechaHoy = new Date().toLocaleDateString('es-VE');

                                let conceptosTexto = "conceptos pendientes";
                                if (est.cobrosHistorial && est.cobrosHistorial.length > 0) {
                                    const pendientes = est.cobrosHistorial.filter(c => c.estatus === 'Pendiente' || c.estatus === 'Revision');
                                    if (pendientes.length > 0) {
                                        conceptosTexto = pendientes.map(p => p.concepto).join(' y ');
                                    }
                                }

                                const textoWp = `Hola *${est.nombre_representante}*, le escribimos de la *Academia de Música Vivace* respecto al estudiante *${est.nombre_estudiante}*.\n\nTiene pendiente el pago por concepto de *${conceptosTexto}*, por un monto total de *$${deudaUsdNum.toFixed(2)}* (equivalente a *${deudaBsNum.toFixed(2)} Bs.* a la tasa oficial BCV del día ${fechaHoy}).\n\nLe recordamos que su aporte y pago puntual es muy importante para mantener nuestra academia activa, garantizando el funcionamiento de las instalaciones y permitiéndonos cumplir con los honorarios de nuestros profesores y personal. ¡Muchas gracias por su apoyo!\n\n*(Este mensaje se genera automático por la app Academia-Vivace)*`;
                            %>
                                <tr class="fila-estudiante" data-nombre="<%= (est.nombre_estudiante || '').toLowerCase() %>" data-grupo="<%= (est.nivel || '').toUpperCase() %>" data-instrumento="<%= (est.instrumento || '').toUpperCase() %>">
                                    <td><strong><%= est.nombre_estudiante %></strong><br><small><%= est.cedula_estudiante %></small></td>
                                    <td><%= est.instrumento %><br><span style="background: #e8f4fd; color: #1e3c72; padding: 2px 6px; border-radius: 4px; font-size: 0.75rem;"><%= est.nivel %></span></td>
                                    <td>
                                        <strong><%= est.nombre_representante %></strong><br>
                                        <small>Telf: <%= est.telefono_representante %> | Correo: <%= est.email_representante %></small>
                                    </td>
                                    <td>
                                        <% if (est.exonerado === 1) { %>
                                            <span class="badge-exonerado">EXONERADO</span>
                                        <% } else if (est.estaAlDia) { %>
                                            <span class="badge-aldia">AL DÍA</span>
                                        <% } else { %>
                                            <span class="badge-moroso">MOROSO ($<%= deudaUsdNum.toFixed(2) %>)</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem; flex-wrap: wrap; align-items: center;">
                                            <!-- Formulario para editar datos clave del estudiante / representante -->
                                            <form action="/admin/editar-estudiante" method="POST" style="display: inline-flex; gap: 4px; background: #f8f9fa; padding: 4px; border-radius: 6px; border: 1px solid #ddd; align-items: center;">
                                                <input type="hidden" name="id_estudiante" value="<%= est.id %>">
                                                <input type="text" name="nombre_estudiante" value="<%= est.nombre_estudiante %>" style="width: 105px; font-size: 0.75rem; padding: 3px;" required title="Nombre Alumno">
                                                <input type="text" name="telefono_representante" value="<%= est.telefono_representante %>" style="width: 85px; font-size: 0.75rem; padding: 3px;" required title="Teléfono">
                                                <input type="email" name="email_representante" value="<%= est.email_representante %>" style="width: 120px; font-size: 0.75rem; padding: 3px;" required title="Correo de Acceso">
                                                <select name="exonerado" style="font-size: 0.75rem; padding: 3px;" title="Estatus Exoneración">
                                                    <option value="0" <%= est.exonerado === 0 ? 'selected' : '' %>>Normal</option>
                                                    <option value="1" <%= est.exonerado === 1 ? 'selected' : '' %>>Exonerado</option>
                                                </select>
                                                <button type="submit" style="background: #0077b6; color: white; border: none; padding: 3px 6px; border-radius: 4px; font-size: 0.75rem; cursor: pointer;" title="Guardar cambios">💾</button>
                                            </form>

                                            <!-- Botón WhatsApp Manual -->
                                            <a href="https://wa.me/<%= String(est.telefono_representante || '').replace(/\D/g, '').startsWith('58') ? String(est.telefono_representante || '').replace(/\D/g, '') : '58' + String(est.telefono_representante || '').replace(/\D/g, '') %>?text=<%= encodeURIComponent(textoWp) %>" 
                                               target="_blank" 
                                               style="background: #25d366; color: white; padding: 5px 10px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.78rem;" 
                                               title="Enviar por WhatsApp Manual">💬 WhatsApp</a>

                                            <button onclick="verExpedienteModal('<%= est.id %>')" style="background: #7b2cbf; color: white; border: none; padding: 5px 8px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 0.78rem;" title="Ver Expediente">📋</button>
                                            <a href="/carnet/<%= est.codigo_qr %>" target="_blank" style="background: #27ae60; color: white; text-decoration: none; padding: 5px 8px; border-radius: 4px; font-weight: bold; font-size: 0.78rem;" title="Ver Carnet">🪪</a>

                                            <!-- Botón para Eliminar Estudiante -->
                                            <form action="/admin/eliminar-estudiante" method="POST" style="display: inline-block;" onsubmit="return confirm('¿Está seguro de eliminar a este estudiante del sistema? Se borrarán sus datos y cobros asociados.');">
                                                <input type="hidden" name="id_estudiante" value="<%= est.id %>">
                                                <button type="submit" style="background: #e63946; color: white; border: none; padding: 5px 8px; border-radius: 4px; font-size: 0.78rem; cursor: pointer;" title="Eliminar estudiante">🗑️</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="5" style="text-align: center; color: #888; padding: 2rem;">No hay estudiantes registrados.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- FORMULARIO DE REGISTRO DE PAGO / TASA HISTÓRICA CON MONTO EXACTO INGRESADO -->
            <div style="background: #f8f9fa; border: 1px solid #cbd5e1; padding: 1.5rem; border-radius: 12px; margin-top: 2rem;">
                <h3 style="color: #1e3c72; margin-bottom: 0.5rem;">⚙️ Registrar Pago / Liquidar Deuda con Tasa e Ingreso Manual Exacto</h3>
                <p style="font-size: 0.85rem; color: #666; margin-bottom: 1rem;">El monto ingresado en bolívares/dólares se reflejará exactamente en la contabilidad según el comprobante, sin recalcularse con la tasa del día actual.</p>

                <form action="/admin/registrar-pago-historico" method="POST" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
                    
                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Seleccionar Estudiante *</label>
                        <select name="id_estudiante" id="selectEstudianteHistorico" onchange="cargarDeudasEstudiante()" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                            <option value="">Seleccione estudiante...</option>
                            <% if (typeof estudiantes !== 'undefined' && estudiantes && estudiantes.length > 0) { %>
                                <% estudiantes.forEach(est => { %>
                                    <option value="<%= est.id %>"><%= est.nombre_estudiante %> (<%= est.instrumento %>)</option>
                                <% }); %>
                            <% } %>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Concepto Pendiente *</label>
                        <select name="id_cobro" id="selectConceptoMorosidad" onchange="actualizarMontoSugeridoCobro()" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                            <option value="">Primero seleccione un estudiante...</option>
                        </select>
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Monto en USD ($) *</label>
                        <input type="number" step="0.01" name="monto_usd" id="inputMontoUsdCobro" placeholder="Ej: 10.00" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Monto Exacto Pagado en Bs. *</label>
                        <input type="number" step="0.01" name="inputMontoExactoVes" id="inputMontoExactoVes" placeholder="Ej: 8137.40" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Tasa Histórica de Referencia (Bs/$) *</label>
                        <input type="number" step="0.01" name="tasa_historica" value="<%= Number(typeof tasaBCV !== 'undefined' ? tasaBCV : 813.74).toFixed(2) %>" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">Fecha del Pago *</label>
                        <input type="date" name="fecha_pago" id="inputFechaPagoHistorico" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                    </div>

                    <div class="form-group" style="margin-bottom: 0;">
                        <label style="font-size: 0.82rem; font-weight: bold;">N° Referencia / Comprobante *</label>
                        <input type="text" name="comprobante" placeholder="Ej: 12345678" required style="padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%;">
                    </div>

                    <div style="display: flex; align-items: flex-end;">
                        <button type="submit" style="background: #27ae60; color: white; border: none; padding: 9px 15px; border-radius: 6px; font-weight: bold; cursor: pointer; width: 100%;">Liquidar Deuda y Guardar</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- MÓDULO 3: FINANZAS Y SENIAT -->
        <div id="seccion-finanzas" class="seccion-admin">
            <button class="btn-volver" onclick="volverInicio()">⬅ Menú Principal</button>
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; margin-bottom: 1rem;">
                <div>
                    <h2 style="color: var(--vivace-purple, #7b2cbf); margin: 0;">Control Financiero y Declaración SENIAT (<%= typeof nombreMesActual !== 'undefined' ? nombreMesActual : '' %>)</h2>
                    <p style="color: #666; margin: 0.2rem 0 0 0;">Servicios Educativos Exentos de IVA y Libro de Compras.</p>
                </div>
                <a href="/admin/exportar-libro-compras" style="background: #1d6f42; color: white; padding: 10px 18px; text-decoration: none; border-radius: 6px; font-weight: bold;">📊 Exportar Libro SENIAT (.csv)</a>
            </div>

            <!-- TARJETAS DE INDICADORES FINANCIEROS Y FISCALES -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; margin-bottom: 2rem;">
                <div style="background: #e8f8f5; border-left: 5px solid #27ae60; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #27ae60; margin:0; font-size: 0.85rem;">💰 Ingresos Totales</h4>
                    <p style="font-size: 1.2rem; font-weight: bold; margin: 5px 0;"><%= Number(typeof totalIngresosVES !== 'undefined' ? totalIngresosVES : 0).toFixed(2) %> Bs.</p>
                </div>
                <div style="background: #fdf2e9; border-left: 5px solid #e67e22; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #d35400; margin:0; font-size: 0.85rem;">🛒 Egresos Totales</h4>
                    <p style="font-size: 1.2rem; font-weight: bold; margin: 5px 0;"><%= Number(typeof totalEgresosVES !== 'undefined' ? totalEgresosVES : 0).toFixed(2) %> Bs.</p>
                </div>
                <div style="background: #e8f4fd; border-left: 5px solid #0077b6; padding: 1rem; border-radius: 8px;">
                    <h4 style="color: #0077b6; margin:0; font-size: 0.85rem;">👥 Egresos de Nómina</h4>
                    <p style="font-size: 1.2rem; font-weight: bold; margin: 5px 0;"><%= Number(typeof totalNominaPagadaVES !== 'undefined' ? totalNominaPagadaVES : 0).toFixed(2) %> Bs.</p>
                </div>
                <div style="background: #ebf5fb; border-left: 5px solid #2980b9; padding: 1rem; border-radius: 8px;" title="El servicio educativo es exento, por lo tanto no genera impuesto a cobrar a los clientes.">
                    <h4 style="color: #2980b9; margin:0; font-size: 0.85rem;">📄 IVA Débito</h4>
                    <p style="font-size: 1.1rem; font-weight: bold; margin: 5px 0;">0.00 Bs. <span style="font-size:0.7rem; color:#666;">(Exento)</span></p>
                </div>
                <div style="background: #fef9e7; border-left: 5px solid #f1c40f; padding: 1rem; border-radius: 8px;" title="Crédito fiscal acumulado por el IVA pagado en tus compras con factura legal.">
                    <h4 style="color: #b7950b; margin:0; font-size: 0.85rem;">📥 IVA Crédito</h4>
                    <p style="font-size: 1.2rem; font-weight: bold; margin: 5px 0;"><%= Number(typeof totalIvaCreditoVES !== 'undefined' ? totalIvaCreditoVES : 0).toFixed(2) %> Bs.</p>
                </div>
                <div style="background: #fce7f3; border-left: 5px solid #db2777; padding: 1rem; border-radius: 8px;" title="Impuesto final a declarar. Al ser la academia un instituto educativo exento, el IVA de tus compras se convierte en un crédito a favor o excedente para el siguiente mes.">
                    <h4 style="color: #be185d; margin:0; font-size: 0.85rem;">🏛️ IVA a Declarar</h4>
                    <p style="font-size: 1.1rem; font-weight: bold; margin: 5px 0;">0.00 Bs. <span style="font-size:0.7rem; color:#db2777;">(Excedente)</span></p>
                </div>
            </div>

            <!-- FORMULARIO DE REGISTRO DE COMPRA CON GUÍA Y FECHA -->
            <div style="background: #f8f9fa; padding: 1.5rem; border-radius: 10px; border: 1px solid #ddd;">
                <h3 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.3rem;">+ Registrar Egreso / Compra para Libro SENIAT</h3>
                <p style="font-size: 0.85rem; color: #555; margin-bottom: 1rem;">
                    💡 <em>Guía rápida:</em> Si la compra tiene <strong>Factura con IVA (16%)</strong>, selecciona esa opción y coloca el <strong>Monto Total</strong> exacto que indica la factura; el sistema calculará automáticamente la Base y el IVA desglosado. Si es sin factura o exento, colócalo como exento.
                </p>

                <form action="/admin/agregar-egreso" method="POST">
                    <div class="form-grid">
                        <div class="form-group"><label>Proveedor *</label><input type="text" name="proveedor" required placeholder="Ej: Librería o Sup."></div>
                        <div class="form-group"><label>RIF del Proveedor *</label><input type="text" name="rif" required placeholder="Ej: J-12345678-9"></div>
                        <div class="form-group"><label>Fecha de la Factura *</label><input type="date" name="fecha_egreso" id="inputFechaEgresoDefault" required></div>
                        <div class="form-group"><label>N° Factura</label><input type="text" name="numero_factura" placeholder="Ej: 0001425"></div>
                        <div class="form-group"><label>N° Control</label><input type="text" name="numero_control" placeholder="Ej: 00-001254"></div>
                        <div class="form-group"><label>Concepto / Detalle *</label><input type="text" name="concepto" required placeholder="Ej: Compra de papelería"></div>
                        <div class="form-group"><label>Monto Total en Bolívares (Bs.) *</label><input type="number" step="0.01" name="monto_ves" required placeholder="Ej: 1500.00"></div>
                        <div class="form-group">
                            <label>Soporte Fiscal *</label>
                            <select name="tiene_factura" id="selectTipoSoporte">
                                <option value="1">FACTURA CON IVA (16%)</option>
                                <option value="0">SIN FACTURA / EXENTO</option>
                            </select>
                        </div>
                        <div class="form-group"><label>Equiv. en Dólares ($)</label><input type="number" step="0.01" name="monto_usd" placeholder="Ej: 10.00"></div>
                    </div>
                    <button type="submit" class="btn-submit-orange" style="width:100%; margin-top:1.2rem;">Guardar Compra en el Libro</button>
                </form>
            </div>

            <h3 style="color: var(--vivace-purple, #7b2cbf); margin-top: 2.2rem;">Libro de Compras Registradas (SENIAT)</h3>
            <div style="overflow-x: auto; margin-top: 0.8rem;">
                <table class="table-custom">
                    <thead>
                        <tr><th>Op.</th><th>Fecha Factura</th><th>RIF</th><th>Proveedor</th><th>Factura</th><th>Control</th><th>Total (Bs)</th><th>Exentas</th><th>Base (16%)</th><th>IVA (Bs)</th></tr>
                    </thead>
                    <tbody>
                        <% if (typeof egresos !== 'undefined' && egresos && egresos.length > 0) { %>
                            <% egresos.forEach((e, index) => { 
                                const tf = e.tiene_factura === 1;
                                const tot = Number(e.monto_ves || 0);
                                const bas = tf ? Number(e.base_imponible_ves || 0) : 0;
                                const iva = tf ? Number(e.monto_iva_ves || 0) : 0;
                                const exe = tf ? 0 : tot;
                            %>
                                <tr>
                                    <td><%= index + 1 %></td>
                                    <td><%= String(e.fecha_egreso || '').substring(0,10) %></td>
                                    <td><strong><%= e.rif %></strong></td>
                                    <td><%= e.proveedor %></td>
                                    <td><%= e.numero_factura || 'N/A' %></td>
                                    <td><%= e.numero_control || 'N/A' %></td>
                                    <td><strong><%= tot.toFixed(2) %> Bs.</strong></td>
                                    <td style="color:#c0392b;"><%= exe.toFixed(2) %> Bs.</td>
                                    <td><%= bas.toFixed(2) %> Bs.</td>
                                    <td style="color:#27ae60; font-weight:bold;"><%= iva.toFixed(2) %> Bs.</td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="10" style="text-align: center; color: #888; padding: 1.5rem;">No hay compras registradas.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MÓDULO 4: CONCILIACIÓN BANCARIA Y FACTURACIÓN -->
        <div id="seccion-conciliacion" class="seccion-admin">
            <button class="btn-volver" onclick="volverInicio()">⬅ Menú Principal</button>
            <h2 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.5rem;">Conciliación de Pagos Móviles y Facturación</h2>
            <p style="color: #666; font-size: 0.9rem; margin-bottom: 1.5rem;">Verifica el pago reportado, emite tu factura fiscal y coloca el número correspondiente antes de aprobar.</p>
            
            <div style="overflow-x: auto;">
                <% if (typeof cobrosPorRevisar !== 'undefined' && cobrosPorRevisar && cobrosPorRevisar.length > 0) { %>
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Estudiante</th>
                                <th>Concepto</th>
                                <th>Monto</th>
                                <th>Ref. / Comprobante</th>
                                <th>Acción y Facturación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% cobrosPorRevisar.forEach(c => { 
                                const montoUsdC = Number(c.monto_usd || 0);
                                const montoBsC = montoUsdC * Number(typeof tasaBCV !== 'undefined' ? tasaBCV : 813.74);
                                const textoWpConciliacion = `Hola *${c.nombre_representante}*, le escribimos de la *Academia de Música Vivace* para confirmarle que el pago por concepto de *${c.concepto}* ($${montoUsdC.toFixed(2)} / ${montoBsC.toFixed(2)} Bs.) ha sido verificado y validado exitosamente. ¡Muchas gracias por su apoyo!`;
                            %>
                                <tr>
                                    <td><strong><%= c.nombre_estudiante %></strong><br><small><%= c.nombre_representante %></small></td>
                                    <td><%= c.concepto %></td>
                                    <td>$<%= c.monto_usd %></td>
                                    <td><span style="background: #fff3cd; padding: 4px; font-weight: bold;"><%= c.comprobante %></span></td>
                                    <td>
                                        <div style="display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap;">
                                            <!-- WhatsApp Manual -->
                                            <a href="https://wa.me/<%= String(c.telefono_representante || '').replace(/\D/g, '').startsWith('58') ? String(c.telefono_representante || '').replace(/\D/g, '') : '58' + String(c.telefono_representante || '').replace(/\D/g, '') %>?text=<%= encodeURIComponent(textoWpConciliacion) %>" 
                                               target="_blank" 
                                               style="background: #25d366; color: white; padding: 6px 10px; border-radius: 4px; text-decoration: none; font-weight: bold; font-size: 0.78rem;" 
                                               title="Agradecer por WhatsApp">💬 WhatsApp</a>

                                            <!-- Formulario con input de N° de Factura -->
                                            <form action="/admin/conciliar-pago" method="POST" style="display: inline-flex; gap: 4px; align-items: center; background: #f8f9fa; padding: 4px; border-radius: 6px; border: 1px solid #ddd;">
                                                <input type="hidden" name="id_cobro" value="<%= c.id %>">
                                                <input type="hidden" name="accion" value="aprobar">
                                                <input type="text" name="numero_factura_emitida" placeholder="N° Factura" required style="width: 90px; font-size: 0.75rem; padding: 4px; border: 1px solid #ccc; border-radius: 4px;" title="Ingrese el N° de factura emitida">
                                                <button type="submit" style="background: #27ae60; color: white; border: none; padding: 5px 10px; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 0.78rem;">Validar</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p style="text-align: center; color: #777; padding: 2rem;">No hay pagos pendientes por revisar.</p>
                <% } %>
            </div>
        </div>

        <!-- MÓDULO 5: NÓMINA DE PERSONAL -->
        <div id="seccion-personal" class="seccion-admin">
            <button class="btn-volver" onclick="volverInicio()">⬅ Menú Principal</button>
            <h2 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.5rem;">Nómina de Profesores y Personal (<%= typeof nombreMesActual !== 'undefined' ? nombreMesActual : '' %>)</h2>
            <p style="color: #666; margin-bottom: 1rem;">Haz click en cualquier concepto para registrar su pago completo.</p>

            <div class="<%= (typeof cajaCubreNomina !== 'undefined' && cajaCubreNomina) ? 'box-liquidez-ok' : 'box-liquidez-alerta' %>">
                <div>
                    <h3 style="margin: 0; font-size: 1.1rem;"><%= (typeof cajaCubreNomina !== 'undefined' && cajaCubreNomina) ? '✔ DISPONIBILIDAD EN CAJA CONFIRMADA' : '⚠ ATENCIÓN: LIQUIDEZ AJUSTADA' %></h3>
                    <p style="margin: 4px 0 0 0; font-size: 0.9rem;">
                        Pendiente Total por Liquidar: <strong><%= Number(typeof totalNominaRequeridaVES !== 'undefined' ? totalNominaRequeridaVES : 0).toFixed(2) %> Bs. ($<%= Number(typeof totalNominaRequeridaUSD !== 'undefined' ? totalNominaRequeridaUSD : 0).toFixed(2) %>)</strong> | 
                        Saldo Caja: <strong>$<%= Number(typeof saldoCajaUSD !== 'undefined' ? saldoCajaUSD : 0).toFixed(2) %></strong>
                    </p>
                </div>
            </div>

            <div style="overflow-x: auto;">
                <% if (typeof personal !== 'undefined' && personal && personal.length > 0) { %>
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Colaborador / Cargo</th>
                                <th>Sueldo Básico</th>
                                <th>Cesta Ticket</th>
                                <th>Transporte</th>
                                <th>Saldo Pendiente Mes</th>
                                <th>Acción Docente</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% personal.forEach(p => { 
                                const pendienteVES = Number(p.saldoPendienteVES || 0);
                            %>
                                <tr>
                                    <td>
                                        <strong><%= p.nombre_empleado %></strong><br>
                                        <small style="color: var(--vivace-blue, #0077b6); font-weight: bold;"><%= p.cargo %></small><br>
                                        <small style="color: #666;"><%= p.email %></small>
                                    </td>
                                    <td>
                                        <button type="button" class="<%= p.sueldoCompleto ? 'btn-estado-pagado' : 'btn-estado-pendiente' %>" onclick="abrirModalPagoDocente('<%= p.id %>', 'SUELDO_BASE')">
                                            <%= p.sueldoCompleto ? 'PAGADO (VERDE)' : 'PENDIENTE' %>
                                        </button>
                                    </td>
                                    <td>
                                        <button type="button" class="<%= p.alimentacionCompleta ? 'btn-estado-pagado' : 'btn-estado-pendiente' %>" onclick="abrirModalPagoDocente('<%= p.id %>', 'CESTA_TICKET')">
                                            <%= p.alimentacionCompleta ? 'PAGADO (VERDE)' : 'PENDIENTE' %>
                                        </button>
                                    </td>
                                    <td>
                                        <button type="button" class="<%= p.transporteCompleto ? 'btn-estado-pagado' : 'btn-estado-pendiente' %>" onclick="abrirModalPagoDocente('<%= p.id %>', 'TRANSPORTE')">
                                            <%= p.transporteCompleto ? 'PAGADO (VERDE)' : 'PENDIENTE' %>
                                        </button>
                                    </td>
                                    <td class="<%= pendienteVES > 0 ? 'txt-pendiente-deuda' : 'txt-pendiente-ok' %>">
                                        <%= pendienteVES.toFixed(2) %> Bs.
                                    </td>
                                    <td style="display: flex; gap: 0.4rem;">
                                        <button type="button" onclick="abrirModalPagoDocente('<%= p.id %>', 'SUELDO_BASE')" style="background: #27ae60; color: white; border: none; padding: 6px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; cursor: pointer;">💳 Pagar</button>
                                        <a href="/docente/portal/<%= p.id %>" target="_blank" style="background: var(--vivace-blue, #0077b6); color: white; text-decoration: none; padding: 6px 10px; border-radius: 4px; font-weight: bold; font-size: 0.8rem; display: inline-block;">📄 Recibo</a>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } else { %>
                    <p style="text-align: center; color: #888; padding: 2rem;">No hay personal registrado.</p>
                <% } %>
            </div>

            <hr style="margin: 2rem 0;">
            <h3 style="color: var(--vivace-purple, #7b2cbf);">+ Registrar Nuevo Colaborador</h3>
            <form action="/admin/agregar-personal" method="POST" style="background: #f8f9fa; padding: 1.2rem; border-radius: 8px; border: 1px solid #ddd; margin-top: 1rem;">
                <div class="form-grid">
                    <div class="form-group"><label>Nombre Completo *</label><input type="text" name="nombre_empleado" required></div>
                    <div class="form-group"><label>Cédula</label><input type="text" name="cedula"></div>
                    <div class="form-group">
                        <label>Cátedra / Cargo del Colaborador *</label>
                        <select name="cargo" required>
                            <option value="">Seleccione cargo o cátedra...</option>
                            <option value="Personal Administrativo / Secretaría">Personal Administrativo / Secretaría</option>
                            <option value="Teclado">Teclado</option>
                            <option value="Cuatro">Cuatro</option>
                            <option value="Guitarra">Guitarra</option>
                            <option value="Bajo Eléctrico">Bajo Eléctrico</option>
                            <option value="Percusión">Percusión</option>
                            <option value="Coro">Coro (Todos los alumnos)</option>
                            <option value="Lenguaje Musical">Lenguaje Musical (Todos los alumnos)</option>
                            <option value="Ensayo">Ensayo</option>
                        </select>
                    </div>
                    <div class="form-group"><label>Teléfono</label><input type="text" name="telefono"></div>
                    <div class="form-group"><label>Correo (Acceso al Portal) *</label><input type="email" name="email" required></div>
                    <div class="form-group"><label>Horas Mes</label><input type="number" name="horas_mes" required></div>
                    <div class="form-group"><label>Sueldo Básico (Bs.) *</label><input type="number" step="0.01" name="sueldo_base_ves" required></div>
                    <div class="form-group"><label>Cesta Ticket ($ BCV) *</label><input type="number" step="0.01" name="bono_alimentacion_usd" required></div>
                    <div class="form-group"><label>Transporte ($ BCV) *</label><input type="number" step="0.01" name="bono_transporte_usd" required></div>
                    <div class="form-group"><label>Datos Pago Móvil</label><input type="text" name="pago_movil_datos"></div>
                </div>
                <button type="submit" class="btn-submit-green" style="margin-top: 1rem;">Guardar Colaborador</button>
            </form>

            <!-- MONITOREO Y EDICIÓN GLOBAL DE ASISTENCIAS Y NOTAS -->
            <div style="background: white; padding: 1.5rem; border-radius: 12px; border: 1px solid #ddd; margin-top: 2.5rem;">
                <h3 style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 1rem;">📊 Monitoreo y Edición Global de Asistencias y Notas</h3>

                <h4 style="color: #444; font-size: 0.95rem; margin-bottom: 0.4rem;">Listado General de Asistencias Registradas</h4>
                <div style="overflow-x: auto; max-height: 280px; margin-bottom: 1.5rem;">
                    <table class="table-custom" style="font-size: 0.8rem;">
                        <thead>
                            <tr><th>Fecha</th><th>Cátedra</th><th>Estudiante</th><th>Estado</th><th>Modificar</th></tr>
                        </thead>
                        <tbody>
                            <% if (typeof todasAsistencias !== 'undefined' && todasAsistencias && todasAsistencias.length > 0) { %>
                                <% todasAsistencias.forEach(asig => { %>
                                    <tr>
                                        <td><%= asig.fecha %></td>
                                        <td><%= asig.catedra %></td>
                                        <td>
                                            <strong><%= asig.nombre_estudiante %></strong> 
                                        </td>
                                        <td><%= asig.estado %></td>
                                        <td>
                                            <form action="/admin/modificar-asistencia" method="POST" style="display: flex; gap: 0.4rem;">
                                                <input type="hidden" name="id_asistencia" value="<%= asig.id %>">
                                                <select name="estado" style="padding: 3px; font-size: 0.75rem;">
                                                    <option value="Presente" <%= asig.estado === 'Presente' ? 'selected' : '' %>>Presente</option>
                                                    <option value="Ausente" <%= asig.estado === 'Ausente' ? 'selected' : '' %>>Ausente</option>
                                                    <option value="Justificado" <%= asig.estado === 'Justificado' ? 'selected' : '' %>>Justificado</option>
                                                </select>
                                                <button type="submit" style="background: #2980b9; color: white; border: none; padding: 3px 8px; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Actualizar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="5" style="text-align: center; color: #888;">No hay asistencias registradas.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>

                <h4 style="color: #444; font-size: 0.95rem; margin-bottom: 0.4rem;">Listado General de Calificaciones Registradas</h4>
                <div style="overflow-x: auto; max-height: 280px;">
                    <table class="table-custom" style="font-size: 0.8rem;">
                        <thead>
                            <tr><th>Período</th><th>Cátedra / Objetivo</th><th>Estudiante</th><th>Nota / Obs</th><th>Modificar</th></tr>
                        </thead>
                        <tbody>
                            <% if (typeof todasCalificaciones !== 'undefined' && todasCalificaciones && todasCalificaciones.length > 0) { %>
                                <% todasCalificaciones.forEach(cal => { %>
                                    <tr>
                                        <td><%= cal.periodo %></td>
                                        <td><%= cal.catedra %> - <%= cal.objetivo %></td>
                                        <td>
                                            <strong><%= cal.nombre_estudiante %></strong> 
                                        </td>
                                        <td><%= cal.calificacion %></td>
                                        <td>
                                            <form action="/admin/modificar-calificacion" method="POST" style="display: flex; gap: 0.4rem; align-items: center;">
                                                <input type="hidden" name="id_calificacion" value="<%= cal.id %>">
                                                <input type="text" name="calificacion" value="<%= cal.calificacion %>" style="width: 60px; padding: 3px; font-size: 0.75rem;">
                                                <input type="text" name="observacion" value="<%= cal.observacion || '' %>" placeholder="Obs..." style="width: 100px; padding: 3px; font-size: 0.75rem;">
                                                <button type="submit" style="background: #27ae60; color: white; border: none; padding: 3px 8px; border-radius: 4px; cursor: pointer; font-size: 0.75rem;">Guardar</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="5" style="text-align: center; color: #888;">No hay calificaciones registradas.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <!-- MODAL EXPEDIENTE ESTUDIANTE -->
    <div id="modalExpediente" class="modal-bg">
        <div class="modal-card">
            <span class="close-modal" onclick="cerrarModalExpediente()">&times;</span>
            <h2 id="modalNombreEstudiante" style="color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.3rem;"></h2>
            <p style="color: #666; margin-bottom: 0.5rem;">Representante: <strong id="modalNombreRepresentante"></strong></p>
            <p style="color: #666; margin-bottom: 1rem;">Cédula: <strong id="modalCedulaEstudiante"></strong> | Instrumento: <strong id="modalInstrumentoEstudiante"></strong> | Grupo: <strong id="modalGrupoEstudiante"></strong></p>
            
            <div style="background: #f8f9fa; border: 1px solid #ddd; border-radius: 8px; padding: 1rem; text-align: center; margin-bottom: 1.2rem;">
                <p style="font-weight: bold; color: var(--vivace-purple, #7b2cbf); margin-bottom: 0.5rem;">Carnet y Código QR del Estudiante</p>
                <div id="modalQrContenedor" style="margin-bottom: 0.5rem;"></div>
                <a id="modalLinkCarnet" href="#" target="_blank" style="background: #27ae60; color: white; text-decoration: none; padding: 6px 14px; border-radius: 4px; font-weight: bold; font-size: 0.85rem; display: inline-block;">🪪 Ver Carnet Completo para Imprimir</a>
            </div>

            <h3 style="color: var(--vivace-purple, #7b2cbf); font-size: 1rem; margin-bottom: 0.5rem;">Historial de Cobros</h3>
            <table class="table-custom">
                <thead><tr><th>Concepto</th><th>Monto</th><th>Estatus</th></tr></thead>
                <tbody id="modalTablaCobros"></tbody>
            </table>
            <hr style="margin: 1rem 0;">
            <form action="/admin/agregar-cobro-estudiante" method="POST" style="display: flex; gap: 0.5rem;">
                <input type="hidden" name="id_estudiante" id="inputModalIdEstudiante">
                <input type="text" name="concepto" placeholder="Concepto cobro" required style="flex: 2; padding: 8px;">
                <input type="number" step="0.01" name="monto_usd" placeholder="Monto $" required style="flex: 1; padding: 8px;">
                <button type="submit" class="btn-submit-green" style="margin-top:0; width: auto;">Asignar</button>
            </form>
        </div>
    </div>

    <!-- MODAL PAGO DOCENTE -->
    <div id="modalPagoDocente" class="modal-bg">
        <div class="modal-card">
            <span class="close-modal" onclick="cerrarModalPagoDocente()">&times;</span>
            <h2 id="pagoDocenteNombre" style="color: var(--vivace-purple, #7b2cbf);"></h2>
            <p style="color: #666; margin-bottom: 1rem;">Cargo: <strong id="pagoDocenteCargo"></strong></p>

            <form action="/admin/registrar-pago-individual-docente" method="POST" style="background: #f8f9fa; padding: 1.2rem; border-radius: 8px; border: 1px solid #ddd;">
                <input type="hidden" name="id_personal" id="pagoDocenteId">
                <div class="form-grid">
                    <div class="form-group">
                        <label>Concepto a Pagar *</label>
                        <select name="tipo_pago" id="selectTipoPago" onchange="actualizarMontoSugerido()" required>
                            <option value="SUELDO_BASE">Sueldo Básico (Bs.)</option>
                            <option value="CESTA_TICKET">Cesta Ticket / Alimentación (Bs.)</option>
                            <option value="TRANSPORTE">Bono de Transporte (Bs.)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Monto Exacto en Bolívares (Bs.) *</label>
                        <input type="number" step="0.01" name="monto_ves" id="inputMontoVes" required>
                        <div id="boxInfoMonto" class="info-monto-sugerido"></div>
                    </div>
                    <div class="form-group"><label>N° Referencia *</label><input type="text" name="referencia" required></div>
                    <div class="form-group"><label>Fecha *</label><input type="date" name="fecha_pago" id="inputFechaPago" required></div>
                </div>
                <div class="form-group" style="margin-top: 0.8rem;"><label>Observación</label><input type="text" name="observacion" placeholder="Ej: Pago completo del mes"></div>
                <button type="submit" class="btn-submit-green" style="width:100%; margin-top:1rem;">Registrar Pago</button>
            </form>

            <h3 style="color: var(--vivace-purple, #7b2cbf); margin-top: 1.5rem; font-size: 1rem;">Historial de Pagos de este Mes</h3>
            <div style="overflow-x: auto; margin-top: 0.5rem;">
                <table class="table-custom">
                    <thead><tr><th>Concepto</th><th>Monto (Bs)</th><th>Ref</th><th>Fecha</th></tr></thead>
                    <tbody id="tablaPagosDocenteBody"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- SECCIÓN SEGURA DE DATOS JSON -->
    <script id="datos-estudiantes" type="application/json"><%- JSON.stringify(typeof estudiantes !== 'undefined' && estudiantes ? estudiantes : []) %></script>
    <script id="datos-personal" type="application/json"><%- JSON.stringify(typeof personal !== 'undefined' && personal ? personal : []) %></script>

    <script>
        const tasaBCV = Number('<%= typeof tasaBCV !== 'undefined' ? tasaBCV : 813.74 %>');
        let listaEstudiantes = [], listaPersonal = [], docenteSeleccionado = null;

        try {
            listaEstudiantes = JSON.parse(document.getElementById('datos-estudiantes').textContent.trim() || '[]');
            listaPersonal = JSON.parse(document.getElementById('datos-personal').textContent.trim() || '[]');
        } catch(e) {
            console.error("Error parseando datos JSON:", e);
        }

        document.getElementById('inputFechaPago').value = new Date().toISOString().substring(0,10);
        document.getElementById('inputFechaPagoHistorico').value = new Date().toISOString().substring(0,10);
        document.getElementById('inputFechaEgresoDefault').value = new Date().toISOString().substring(0,10);

        function mostrarSeccion(id) {
            document.getElementById('pantalla-inicio-admin').style.display = 'none';
            document.querySelectorAll('.seccion-admin').forEach(s => s.style.display = 'none');
            document.getElementById('seccion-' + id).style.display = 'block';
        }

        function volverInicio() {
            document.querySelectorAll('.seccion-admin').forEach(s => s.style.display = 'none');
            document.getElementById('pantalla-inicio-admin').style.display = 'block';
        }

        function filtrarTablaEstudiantes() {
            const textoBusqueda = document.getElementById('inputFiltroNombre').value.toLowerCase().trim();
            const grupoSeleccionado = document.getElementById('selectFiltroGrupo').value.toUpperCase().trim();
            const instrumentoSeleccionado = document.getElementById('selectFiltroInstrumento').value.toUpperCase().trim();

            const filas = document.querySelectorAll('.fila-estudiante');
            filas.forEach(fila => {
                const nombre = fila.getAttribute('data-nombre') || '';
                const grupo = fila.getAttribute('data-grupo') || '';
                const instrumento = fila.getAttribute('data-instrumento') || '';

                const coincideNombre = nombre.includes(textoBusqueda);
                const coincideGrupo = !grupoSeleccionado || grupo === grupoSeleccionado;
                const coincideInstrumento = !instrumentoSeleccionado || instrumento === instrumentoSeleccionado;

                if (coincideNombre && coincideGrupo && coincideInstrumento) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });
        }

        function limpiarFiltros() {
            document.getElementById('inputFiltroNombre').value = '';
            document.getElementById('selectFiltroGrupo').value = '';
            document.getElementById('selectFiltroInstrumento').value = '';
            filtrarTablaEstudiantes();
        }

        function cargarDeudasEstudiante() {
            const idEst = document.getElementById('selectEstudianteHistorico').value;
            const selectConcepto = document.getElementById('selectConceptoMorosidad');
            const inputMonto = document.getElementById('inputMontoUsdCobro');
            const inputMontoExactoVes = document.getElementById('inputMontoExactoVes');
            
            selectConcepto.innerHTML = '<option value="">Cargando deudas...</option>';
            inputMonto.value = '';
            if (inputMontoExactoVes) inputMontoExactoVes.value = '';

            if (!idEst) {
                selectConcepto.innerHTML = '<option value="">Primero seleccione un estudiante...</option>';
                return;
            }

            const est = listaEstudiantes.find(e => String(e.id) === String(idEst));
            if (!est || !est.cobrosHistorial || est.cobrosHistorial.length === 0) {
                selectConcepto.innerHTML = '<option value="">El estudiante no tiene deudas pendientes</option>';
                return;
            }

            const deudasPendientes = est.cobrosHistorial.filter(c => c.estatus === 'Pendiente' || c.estatus === 'Revision');

            if (deudasPendientes.length === 0) {
                selectConcepto.innerHTML = '<option value="">¡El estudiante está al día! Sin deudas pendientes</option>';
                return;
            }

            selectConcepto.innerHTML = '<option value="">Seleccione concepto pendiente...</option>';
            deudasPendientes.forEach(d => {
                const opt = document.createElement('option');
                opt.value = d.id;
                opt.setAttribute('data-monto', d.monto_usd);
                opt.text = `${d.concepto} ($${Number(d.monto_usd).toFixed(2)})`;
                selectConcepto.appendChild(opt);
            });
        }

        function actualizarMontoSugeridoCobro() {
            const selectConcepto = document.getElementById('selectConceptoMorosidad');
            const selectedOption = selectConcepto.options[selectConcepto.selectedIndex];
            const montoUsd = selectedOption.getAttribute('data-monto');
            const inputMonto = document.getElementById('inputMontoUsdCobro');
            const inputMontoExactoVes = document.getElementById('inputMontoExactoVes');
            
            if (montoUsd) {
                const usdNum = Number(montoUsd);
                inputMonto.value = usdNum.toFixed(2);
                if (inputMontoExactoVes) {
                    inputMontoExactoVes.value = (usdNum * tasaBCV).toFixed(2);
                }
            } else {
                inputMonto.value = '';
                if (inputMontoExactoVes) inputMontoExactoVes.value = '';
            }
        }
        
        function verExpedienteModal(id) {
            const est = listaEstudiantes.find(e => String(e.id) === String(id));
            if (!est) return;
            document.getElementById('inputModalIdEstudiante').value = est.id;
            document.getElementById('modalNombreEstudiante').innerText = est.nombre_estudiante;
            document.getElementById('modalNombreRepresentante').innerText = est.nombre_representante;
            document.getElementById('modalCedulaEstudiante').innerText = est.cedula_estudiante || 'No indicada';
            document.getElementById('modalInstrumentoEstudiante').innerText = est.instrumento || 'N/A';
            document.getElementById('modalGrupoEstudiante').innerText = est.nivel || 'N/A';
            
            const qrContenedor = document.getElementById('modalQrContenedor');
            const urlCarnet = '/carnet/' + est.codigo_qr;
            document.getElementById('modalLinkCarnet').href = urlCarnet;
            qrContenedor.innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${window.location.origin}${urlCarnet}" alt="Código QR" style="border: 1px solid #ccc; padding: 4px; background: white; border-radius: 4px;">`;

            const tbody = document.getElementById('modalTablaCobros');
            tbody.innerHTML = '';
            if (est.cobrosHistorial && est.cobrosHistorial.length > 0) {
                est.cobrosHistorial.forEach(c => {
                    tbody.innerHTML += `<tr><td><strong>${c.concepto}</strong></td><td>$${c.monto_usd}</td><td><span style="color:${c.estatus === 'Pagado' ? '#27ae60' : '#c0392b'}; font-weight:bold;">${c.estatus}</span></td></tr>`;
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="3" style="text-align:center;">Sin cobros.</td></tr>';
            }
            document.getElementById('modalExpediente').style.display = 'flex';
        }

        function cerrarModalExpediente() { document.getElementById('modalExpediente').style.display = 'none'; }

        function abrirModalPagoDocente(idPersonal, conceptoSugerido) {
            docenteSeleccionado = listaPersonal.find(item => String(item.id) === String(idPersonal));
            if (!docenteSeleccionado) return;
            document.getElementById('pagoDocenteId').value = docenteSeleccionado.id;
            document.getElementById('pagoDocenteNombre').innerText = docenteSeleccionado.nombre_empleado;
            document.getElementById('pagoDocenteCargo').innerText = docenteSeleccionado.cargo;
            if (conceptoSugerido) document.getElementById('selectTipoPago').value = conceptoSugerido;
            
            actualizarMontoSugerido();

            const tbody = document.getElementById('tablaPagosDocenteBody');
            tbody.innerHTML = '';
            if (docenteSeleccionado.historialPagos && docenteSeleccionado.historialPagos.length > 0) {
                docenteSeleccionado.historialPagos.forEach(h => {
                    tbody.innerHTML += `<tr><td><strong>${h.tipo_pago}</strong></td><td style="color:#27ae60; font-weight:bold;">${Number(h.monto_ves).toFixed(2)} Bs.</td><td><small>${h.referencia}</small></td><td><small>${String(h.fecha_pago).substring(0,10)}</small></td></tr>`;
                });
            } else {
                tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:#888;">No hay pagos registrados este mes.</td></tr>';
            }

            document.getElementById('modalPagoDocente').style.display = 'flex';
        }

        function actualizarMontoSugerido() {
            if (!docenteSeleccionado) return;
            const type = document.getElementById('selectTipoPago').value;
            const inputMonto = document.getElementById('inputMontoVes');
            const boxInfo = document.getElementById('boxInfoMonto');
            let monto = 0;

            if (type === 'SUELDO_BASE') {
                monto = parseFloat(docenteSeleccionado.sueldo_base_ves) || 0;
                boxInfo.innerText = "Sueldo Básico total: " + monto.toFixed(2) + " Bs.";
            } else if (type === 'CESTA_TICKET') {
                monto = (parseFloat(docenteSeleccionado.bono_alimentacion_usd) || 0) * tasaBCV;
                boxInfo.innerText = "Cesta Ticket (" + docenteSeleccionado.bono_alimentacion_usd + "$ * " + tasaBCV + "): " + monto.toFixed(2) + " Bs.";
            } else if (type === 'TRANSPORTE') {
                monto = (parseFloat(docenteSeleccionado.bono_transporte_usd) || 0) * tasaBCV;
                boxInfo.innerText = "Transporte (" + docenteSeleccionado.bono_transporte_usd + "$ * " + tasaBCV + "): " + monto.toFixed(2) + " Bs.";
            }
            inputMonto.value = monto > 0 ? monto.toFixed(2) : '';
        }

        function cerrarModalPagoDocente() { document.getElementById('modalPagoDocente').style.display = 'none'; }
    </script>
</body>
</html>