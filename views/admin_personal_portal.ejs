<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal de Personal - Academia Vivace</title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { padding: 2rem; background: #f4f6f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; }
        .container { max-width: 900px; margin: 0 auto; }
        .header-card { background: white; padding: 2rem; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); text-align: center; margin-bottom: 1.5rem; border-top: 5px solid #2a9d8f; }
        .academy-logo { max-width: 180px; height: auto; margin-bottom: 0.8rem; }
        .portal-title { color: #1e3c72; font-size: 1.6rem; margin-bottom: 0.2rem; }
        .portal-subtitle { color: #666; font-size: 0.95rem; }
        .logout-container { margin-top: 0.8rem; }
        .logout-link { color: #e0248c; text-decoration: none; font-weight: bold; font-size: 0.85rem; }

        .card { background: white; border-radius: 14px; padding: 1.8rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 1.5rem; }
        .section-title { color: #1e3c72; font-size: 1.1rem; margin-bottom: 0.8rem; }
        .table-custom { width: 100%; border-collapse: collapse; margin-top: 0.8rem; background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03); }
        .table-custom th { background: #2a9d8f; color: white; text-align: left; padding: 10px 12px; font-size: 0.85rem; }
        .table-custom td { padding: 10px 12px; border-bottom: 1px solid #eee; font-size: 0.85rem; }
        .badge-info { display: inline-block; background: #e0fbfc; color: #0077b6; padding: 6px 14px; border-radius: 20px; font-weight: bold; font-size: 0.85rem; border: 1px solid #00b4d8; }
        .text-center { text-align: center; }
    </style>
</head>
<body>

    <div class="container">
        <div class="header-card">
            <img src="/img/logo_vivace.png" alt="Logo Academia Vivace" class="academy-logo">
            <h1 class="portal-title">Portal de Personal Administrativo</h1>
            <p class="portal-subtitle">Consulta de recibos de pago y remuneraciones laborales.</p>
            <div class="logout-container">
                <a href="/docente/login" class="logout-link">← Cerrar Sesión</a>
            </div>
        </div>

        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem; border-bottom: 2px solid #f1f3f5; padding-bottom: 1.2rem; margin-bottom: 1.2rem;">
                <div>
                    <h2 style="color: #1e3c72; font-size: 1.4rem; margin-bottom: 0.3rem;"><%= miembro.nombre_empleado %></h2>
                    <p style="color: #555; font-size: 0.9rem;">Cargo: <strong style="color: #2a9d8f;"><%= miembro.cargo %></strong> | Cédula: <strong><%= miembro.cedula || 'N/A' %></strong></p>
                    <p style="color: #777; font-size: 0.82rem; margin-top: 2px;">Correo: <%= miembro.email %> | Teléfono: <%= miembro.telefono || 'N/A' %></p>
                </div>
                <div>
                    <span class="badge-info">Tasa BCV: <%= Number(tasaBCV || 813.74).toFixed(2) %> Bs/$</span>
                </div>
            </div>

            <h3 class="section-title">📊 Resumen de Remuneración del Mes</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem;">
                <div style="background: #f8f9fa; padding: 1rem; border-radius: 8px; border: 1px solid #e9ecef;">
                    <span style="font-size: 0.8rem; color: #666;">Sueldo Básico</span>
                    <h4 style="color: #1e3c72; margin-top: 4px;"><%= Number(sueldoBaseVES || 0).toFixed(2) %> Bs.</h4>
                </div>
                <div style="background: #f8f9fa; padding: 1rem; border-radius: 8px; border: 1px solid #e9ecef;">
                    <span style="font-size: 0.8rem; color: #666;">Cesta Ticket (<%= bonoAlimentacionUSD %>$)</span>
                    <h4 style="color: #1e3c72; margin-top: 4px;"><%= Number(alimentacionBs || 0).toFixed(2) %> Bs.</h4>
                </div>
                <div style="background: #f8f9fa; padding: 1rem; border-radius: 8px; border: 1px solid #e9ecef;">
                    <span style="font-size: 0.8rem; color: #666;">Bono Transporte (<%= bonoTransporteUSD %>$)</span>
                    <h4 style="color: #1e3c72; margin-top: 4px;"><%= Number(transporteBs || 0).toFixed(2) %> Bs.</h4>
                </div>
                <div style="background: #e8f8f5; padding: 1rem; border-radius: 8px; border: 1px solid #c3e6cb;">
                    <span style="font-size: 0.8rem; color: #155724; font-weight: bold;">Saldo Pendiente Mes</span>
                    <h4 style="color: #27ae60; margin-top: 4px;"><%= Number(saldoPendienteVES || 0).toFixed(2) %> Bs.</h4>
                </div>
            </div>

            <h3 class="section-title">💳 Historial de Pagos Recibidos</h3>
            <div style="overflow-x: auto;">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>Concepto</th>
                            <th>Monto (Bs)</th>
                            <th>Equiv. ($)</th>
                            <th>Referencia</th>
                            <th>Fecha</th>
                            <th>Observación</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (pagos && pagos.length > 0) { %>
                            <% pagos.forEach(p => { %>
                                <tr>
                                    <td><strong><%= p.tipo_pago %></strong></td>
                                    <td style="color: #27ae60; font-weight: bold;"><%= Number(p.monto_ves || 0).toFixed(2) %> Bs.</td>
                                    <td>$<%= Number(p.monto_usd || 0).toFixed(2) %></td>
                                    <td><%= p.referencia %></td>
                                    <td><%= String(p.fecha_pago || '').substring(0, 10) %></td>
                                    <td><%= p.observacion || 'N/A' %></td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr><td colspan="6" class="text-center" style="color: #888; padding: 1.5rem;">No hay pagos registrados para este período.</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>