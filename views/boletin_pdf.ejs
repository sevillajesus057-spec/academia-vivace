<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Boleta de Rendimiento - <%= estudiante.nombre_estudiante %></title>
    <style>
        :root {
            --vivace-purple: #7b2cbf;
            --vivace-dark: #2d1b4e;
            --vivace-light: #fdf4ff;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #f4f5f7;
            color: #333;
            margin: 0;
            padding: 20px;
        }

        .boletin-container {
            max-width: 900px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(123, 44, 191, 0.1);
            border-top: 8px solid var(--vivace-purple);
        }

        .header-boletin {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #eee;
            padding-bottom: 20px;
            margin-bottom: 25px;
        }

        .logo-area {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-area img {
            width: 70px;
            height: auto;
        }

        .logo-text h1 {
            margin: 0;
            font-size: 1.5rem;
            color: var(--vivace-dark);
            font-weight: 800;
        }

        .logo-text p {
            margin: 2px 0 0;
            font-size: 0.85rem;
            color: #666;
            font-weight: 600;
        }

        .titulo-boleta {
            text-align: right;
        }

        .titulo-boleta h2 {
            margin: 0;
            color: var(--vivace-purple);
            font-size: 1.2rem;
            text-transform: uppercase;
        }

        .titulo-boleta span {
            font-size: 0.85rem;
            background: var(--vivace-light);
            color: var(--vivace-purple);
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: bold;
            display: inline-block;
            margin-top: 6px;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 15px;
            background: var(--vivace-light);
            padding: 15px 20px;
            border-radius: 12px;
            margin-bottom: 25px;
            border: 1px solid #f3e8ff;
        }

        .info-item label {
            display: block;
            font-size: 0.75rem;
            color: #6b7280;
            text-transform: uppercase;
            font-weight: bold;
            margin-bottom: 3px;
        }

        .info-item span {
            font-size: 1rem;
            color: var(--vivace-dark);
            font-weight: 700;
        }

        .categoria-bloque {
            margin-bottom: 25px;
            page-break-inside: avoid;
        }

        .categoria-titulo {
            background: var(--vivace-purple);
            color: white;
            padding: 10px 15px;
            font-size: 0.95rem;
            font-weight: bold;
            border-radius: 8px 8px 0 0;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            border: 1px solid #e5e7eb;
            border-top: none;
            border-radius: 0 0 8px 8px;
            overflow: hidden;
            margin-bottom: 10px;
        }

        th, td {
            padding: 10px 12px;
            font-size: 0.85rem;
            text-align: left;
            border-bottom: 1px solid #f0f2f5;
        }

        th {
            background: #f9fafb;
            color: #374151;
            font-weight: 600;
        }

        .col-indicador {
            width: 80%;
        }

        .col-escala {
            width: 20%;
            text-align: center;
            font-weight: bold;
            color: var(--vivace-purple);
        }

        /* RESUMEN DE ASISTENCIA */
        .asistencia-container {
            margin-top: 25px;
            margin-bottom: 25px;
        }

        .observaciones-box {
            background: #fffbeb;
            border-left: 5px solid #f59e0b;
            padding: 15px 20px;
            border-radius: 0 8px 8px 0;
            margin-top: 25px;
            margin-bottom: 40px;
        }

        .observaciones-box h4 {
            margin: 0 0 8px 0;
            color: #b45309;
            font-size: 0.95rem;
            text-transform: uppercase;
        }

        .observaciones-box p {
            margin: 0;
            font-size: 0.9rem;
            line-height: 1.5;
            color: #78350f;
            text-align: justify;
        }

        /* FIRMA ÚNICA CENTRADA */
        .firma-centro {
            text-align: center;
            margin-top: 50px;
            page-break-inside: avoid;
        }

        .firma-linea {
            width: 300px;
            margin: 0 auto;
            border-top: 2px solid #333;
            padding-top: 8px;
        }

        .firma-linea span {
            display: block;
            font-size: 0.9rem;
            font-weight: bold;
            color: var(--vivace-dark);
        }

        .firma-linea small {
            font-size: 0.78rem;
            color: #666;
        }

        .no-print {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: #27ae60;
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 30px;
            font-weight: bold;
            font-size: 1rem;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.4);
            z-index: 1000;
        }

        @media print {
            body { background: white; padding: 0; }
            .boletin-container { box-shadow: none; border: none; padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>

    <button class="no-print" onclick="window.print()">🖨 Imprimir / Guardar PDF</button>

    <div class="boletin-container">
        <!-- ENCABEZADO -->
        <div class="header-boletin">
            <div class="logo-area">
                <img src="/img/logo_vivace.png" alt="Logo Vivace" onerror="this.src='https://i.ibb.co/3s64n2p/logo-vivace.png'">
                <div class="logo-text">
                    <h1>Academia Vivace</h1>
                    <p>J-50810683-0</p>
                </div>
            </div>
            <div class="titulo-boleta">
                <h2>Boleta de Rendimiento</h2>
                <span>Año Escolar: 2026-2027</span>
            </div>
        </div>

        <!-- DATOS DEL ESTUDIANTE -->
        <div class="info-grid">
            <div class="info-item">
                <label>Apellidos y Nombres del Estudiante</label>
                <span><%= estudiante.nombre_estudiante %></span>
            </div>
            <div class="info-item">
                <label>Instrumento</label>
                <span><%= estudiante.instrumento || 'General' %></span>
            </div>
            <div class="info-item">
                <label>Grupo / Nivel</label>
                <span><%= estudiante.nivel || 'Infantil' %></span>
            </div>
        </div>

        <!-- CALIFICACIONES Y INDICADORES -->
        <% if (estudiante.calificacionesAgrupadas && Object.keys(estudiante.calificacionesAgrupadas).length > 0) { %>
            <% Object.keys(estudiante.calificacionesAgrupadas).forEach(catedra => { %>
                <div class="categoria-bloque">
                    <div class="categoria-titulo">🎼 <%= catedra %></div>
                    <table>
                        <thead>
                            <tr>
                                <th class="col-indicador">Indicador / Criterio de Evaluación</th>
                                <th class="col-escala">Calificación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% estudiante.calificacionesAgrupadas[catedra].forEach(item => { %>
                                <tr>
                                    <td><%= item.indicador || item.objetivo || 'Evaluación general' %></td>
                                    <td class="col-escala"><%= item.calificacion || 'E' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% }); %>
        <% } else { %>
            <p style="text-align: center; color: #666; padding: 2rem;">No hay calificaciones registradas para este periodo.</p>
        <% } %>

        <!-- ASISTENCIA -->
        <% if (estudiante.asistenciaResumen && estudiante.asistenciaResumen.length > 0) { %>
            <div class="asistencia-container">
                <div class="categoria-titulo">📅 Resumen de Asistencia por Cátedra</div>
                <table>
                    <thead>
                        <tr>
                            <th class="col-indicador">Cátedra</th>
                            <th class="col-escala">Clases Asistidas / Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% estudiante.asistenciaResumen.forEach(asist => { %>
                            <tr>
                                <td><%= asist.catedra %></td>
                                <td class="col-escala"><%= asist.totalPresentes %> / <%= asist.totalClases %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <!-- OBSERVACIONES -->
        <div class="observaciones-box">
            <h4>Observaciones del Rendimiento Académico</h4>
            <p>
                <% 
                   let obsTexto = '';
                   if (estudiante.calificacionesAgrupadas) {
                       Object.keys(estudiante.calificacionesAgrupadas).forEach(cat => {
                           estudiante.calificacionesAgrupadas[cat].forEach(item => {
                               if (item.observacion && item.observacion.trim() !== '') {
                                   obsTexto += item.observacion + ' ';
                               }
                           });
                       });
                   }
                %>
                <%= obsTexto.trim() !== '' ? obsTexto : (estudiante.observaciones_medicas || 'Estudiante destacado por su excelente compromiso, evolución artística y notable entusiasmo en cada una de sus cátedras musicales.') %>
            </p>
        </div>

        <!-- FIRMA ÚNICA -->
        <div class="firma-centro">
            <div class="firma-linea">
                <span>Prof. Jesús D. Sevilla</span>
                <small>Dirección General - Academia Vivace</small>
            </div>
        </div>
    </div>

</body>
</html>