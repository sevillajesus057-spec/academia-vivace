<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boletín Académico - <%= estudiante.nombre_estudiante %></title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #333; background: #fff; padding: 1.5rem; }
        .boletin-container { max-width: 800px; margin: 0 auto; border: 2px solid #1e3c72; padding: 1.5rem; border-radius: 12px; }
        
        /* Encabezado compacto y pegado arriba */
        .header-boletin { text-align: center; border-bottom: 2px solid #1e3c72; padding-bottom: 0.6rem; margin-bottom: 0.8rem; }
        .logo { max-width: 90px; height: auto; margin-bottom: 0.1rem; }
        .academy-name { color: #1e3c72; font-size: 1.3rem; font-weight: bold; line-height: 1.1; }
        .academy-subtitle { color: #666; font-size: 0.8rem; margin-top: 1px; }
        .boletin-titulo { color: #333; font-size: 1.1rem; font-weight: bold; margin-top: 0.3rem; letter-spacing: 0.5px; }
        
        .info-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; background: #f8f9fa; padding: 0.7rem 1rem; border-radius: 8px; margin-bottom: 1rem; font-size: 0.85rem; }
        .info-grid p { margin-bottom: 0.2rem; }
        
        .section-title { color: #1e3c72; font-size: 1rem; margin-bottom: 0.4rem; border-left: 4px solid #1e3c72; padding-left: 6px; margin-top: 1rem; }
        
        .table-custom { width: 100%; border-collapse: collapse; margin-bottom: 0.8rem; }
        .table-custom th { background: #1e3c72; color: white; text-align: left; padding: 6px 8px; font-size: 0.8rem; }
        .table-custom td { padding: 6px 8px; border-bottom: 1px solid #ddd; font-size: 0.8rem; }
        
        /* Bloque de firma centrado */
        .footer-boletin { margin-top: 2rem; text-align: center; display: flex; flex-direction: column; align-items: center; }
        .firma-imagen { max-width: 150px; height: auto; margin-bottom: -12px; position: relative; z-index: 2; }
        .firma-linea { width: 260px; border-top: 1px solid #333; margin-top: 4px; padding-top: 4px; }
        .firma-texto { font-size: 0.82rem; color: #333; line-height: 1.2; }
        
        @media print {
            body { padding: 0; background: none; }
            .boletin-container { border: none; padding: 0; }
            .no-print { display: none; }
        }
    </style>
</head>
<body>

    <div class="boletin-container">
        
        <!-- ENCABEZADO COMPACTO -->
        <div class="header-boletin">
            <img src="/img/logo_vivace.png" alt="Logo Academia Vivace" class="logo">
            <div class="academy-name">Academia de Música Vivace</div>
            <div class="academy-subtitle">RIF: J-50810683-0 | Puerto La Cruz, Anzoátegui</div>
            <div class="boletin-titulo">BOLETÍN INFORMATIVO ACADÉMICO</div>
        </div>

        <!-- DATOS DEL ESTUDIANTE -->
        <div class="info-grid">
            <div>
                <p><strong>Estudiante:</strong> <%= estudiante.nombre_estudiante %></p>
                <p><strong>Cédula / Identidad:</strong> <%= estudiante.cedula_estudiante || 'N/A' %></p>
                <p><strong>Cátedra / Instrumento:</strong> <%= estudiante.instrumento %></p>
                <p><strong>Nivel:</strong> <%= estudiante.nivel %></p>
            </div>
            <div>
                <p><strong>Representante:</strong> <%= estudiante.nombre_representante %></p>
                <p><strong>Teléfono:</strong> <%= estudiante.telefono_representante %></p>
                <p><strong>Correo:</strong> <%= estudiante.email_representante %></p>
                <p><strong>Fecha de Emisión:</strong> <%= new Date().toLocaleDateString('es-VE') %></p>
            </div>
        </div>

        <!-- CALIFICACIONES AGRUPADAS POR CÁTEDRA -->
        <h3 class="section-title">📝 Calificaciones y Evaluaciones</h3>
        <% if (estudiante.calificacionesAgrupadas && Object.keys(estudiante.calificacionesAgrupadas).length > 0) { %>
            <% Object.keys(estudiante.calificacionesAgrupadas).forEach(catedra => { %>
                <div style="margin-bottom: 0.8rem;">
                    <h4 style="color: #7b2cbf; font-size: 0.88rem; margin-bottom: 0.3rem; background: #faf5ff; padding: 4px 8px; border-radius: 4px;">Cátedra: <%= catedra %></h4>
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Período</th>
                                <th>Objetivo</th>
                                <th>Indicador</th>
                                <th>Nota</th>
                                <th>Observación</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% estudiante.calificacionesAgrupadas[catedra].forEach(c => { %>
                                <tr>
                                    <td><%= c.periodo %></td>
                                    <td><strong><%= c.objetivo %></strong></td>
                                    <td><%= c.indicador %></td>
                                    <td style="color: #27ae60; font-weight: bold;"><%= c.calificacion %></td>
                                    <td><%= c.observacion || 'N/A' %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% }); %>
        <% } else { %>
            <p style="font-size: 0.85rem; color: #777; font-style: italic; margin-bottom: 1rem;">No se registran calificaciones cargadas en el sistema para este período.</p>
        <% } %>

        <!-- ASISTENCIA CONSOLIDADA POR MATERIA -->
        <h3 class="section-title">📅 Registro de Asistencia a Clases</h3>
        <% if (estudiante.asistenciaResumen && estudiante.asistenciaResumen.length > 0) { %>
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Cátedra / Materia</th>
                        <th>Total Clases Programadas</th>
                        <th>Asistencias Presentes</th>
                    </tr>
                </thead>
                <tbody>
                    <% estudiante.asistenciaResumen.forEach(asig => { %>
                        <tr>
                            <td><strong><%= asig.catedra %></strong></td>
                            <td><%= asig.totalClases %> clases</td>
                            <td style="color: #27ae60; font-weight: bold;"><%= asig.totalPresentes %> asistencias</td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <p style="font-size: 0.85rem; color: #777; font-style: italic; margin-bottom: 1rem;">No se registran asistencias cargadas en el sistema.</p>
        <% } %>

        <!-- FIRMA DEL DIRECTOR CENTRADA -->
        <div class="footer-boletin">
            <img src="/img/firma.png" alt="Firma Director" class="firma-imagen" onerror="this.style.display='none'">
            <div class="firma-linea"></div>
            <div class="firma-texto">
                <strong>Dirección</strong><br>
                <strong>Prof. Jesús Sevilla</strong><br>
                Director de la Academia de Música Vivace
            </div>
        </div>

        <!-- BOTÓN DE IMPRESIÓN (Oculto al imprimir) -->
        <div class="no-print" style="text-align: center; margin-top: 1.5rem;">
            <button onclick="window.print()" style="background: #1e3c72; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 0.9rem;">
                🖨 Imprimir / Guardar como PDF
            </button>
        </div>

    </div>

</body>
</html>